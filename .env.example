# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Reemplaza estos valores con las credenciales de tu proyecto Supabase:
# Panel de Supabase -> Project Settings -> API Keys

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Opcional: Service Role Key (Solo para scripts administrativos o endpoints protegidos del servidor)
# NUNCA expongas este valor en el frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
