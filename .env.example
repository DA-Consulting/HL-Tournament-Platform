# ==============================================================================
# Supabase Configuration (Estándar Actual)
# ==============================================================================
# Obtén tus claves en el panel de Supabase -> Project Settings -> API Keys o en 'Connect'

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Clave secreta (solo servidor, reemplazo oficial de SUPABASE_SERVICE_ROLE_KEY)
# NUNCA expongas este valor en el frontend
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# Variable heredada (opcional para compatibilidad hacia atrás)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...
